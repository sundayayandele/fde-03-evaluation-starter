# Copy to .env for local runs. Never commit .env.
SERVICE_NAME=fde-03-evaluation
ENVIRONMENT=local
LOG_LEVEL=INFO

# LLM provider: mistral (default) | openai | deepseek | qwen | kimi | selfhosted
LLM_PROVIDER=mistral
MISTRAL_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
SELFHOSTED_API_KEY=

# Host port the desktop stacks publish on (127.0.0.1 only)
HOST_PORT=8000
