# Data, models and run artefacts (publish models to the Hugging Face Hub, not Git)
data/
# Evaluation runs hold questions, answers and retrieved passages: commit summaries to
# evals/results/ and text-free baselines to evals/baselines/ instead (see DATASETS.md).
runs/
# FinanceBench may not be redistributed: only its manifest (fingerprint) is committed;
# `rag-eval fetch financebench && rag-eval golden build financebench` recreates the items.
goldens/financebench/*/items.jsonl
labels*.csv
artifacts/*
!artifacts/.gitkeep
models/
checkpoints/
outputs/
mlruns/
wandb/
