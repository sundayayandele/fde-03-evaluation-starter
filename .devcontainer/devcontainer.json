{
  "name": "fde-03-evaluation",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "make install",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "API",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  }
}
